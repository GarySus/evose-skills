{
  "name": "@garysus/evose-skills",
  "version": "0.1.0",
  "description": "Portable skills for operating Evose with a local coding agent",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "test": "node scripts/check.mjs && node skills/evose-platform-manager/scripts/navigation.test.mjs && node skills/evose-platform-manager/scripts/learning.test.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "install:skills": "skills add . --skill evose-platform-manager evose-agent-interaction -a codex -g -y --copy"
  },
  "devDependencies": {
    "skills": "1.7.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GarySus/evose-skills.git"
  },
  "homepage": "https://github.com/GarySus/evose-skills#readme",
  "bugs": {
    "url": "https://github.com/GarySus/evose-skills/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "skills/",
    "docs/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
